# ─────────────────────────────────────────────────────────────
# Revenue Recovery Agent — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Database (local Docker Postgres by default)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/revenue_recovery

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# LLM Provider — NVIDIA NIM (OpenAI-compatible API)
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# App
DEBUG=true
